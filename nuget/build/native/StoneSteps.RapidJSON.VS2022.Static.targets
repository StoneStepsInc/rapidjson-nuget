<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(RapidJSONDir)include\;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RAPIDJSON_HAS_CXX11_RVALUE_REFS;RAPIDJSON_HAS_STDSTRING;RAPIDJSON_HAS_CXX11_NOEXCEPT;RAPIDJSON_HAS_CXX11_RANGE_FOR;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
